{
  "name": "homerealtrainer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@hrt/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "biome check . && turbo run typecheck test",
    "fetch-dem": "pnpm --filter @hrt/world-builder fetch-dem",
    "prepare": "lefthook install",
    "build-world": "pnpm --filter @hrt/world-builder build-world",
    "fetch-assets": "pnpm --filter @hrt/world-builder fetch-assets",
    "import-avatar": "pnpm --filter @hrt/world-builder import-avatar",
    "start": "pnpm --filter @hrt/web build && pnpm --filter @hrt/web preview",
    "bench": "pnpm --filter @hrt/bench bench",
    "bench:compare": "pnpm --filter @hrt/bench compare"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^20.19.43",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
