{
  "$name": "HomeRealTrainer v2 — design tokens",
  "$description": "Source de vérité : feuille hrt.css (variables CSS). Chaque clé correspond à une variable --nom. Les variantes daltoniennes (colorblind) ne listent que les jetons qui changent ; elles se posent par-dessus le thème (data-cb sur la racine).",
  "color": {
    "dark": {
      "neutral": {
        "bg-0": "#0A0D14",
        "bg-1": "rgba(24,30,44,.62)",
        "bg-2": "rgba(255,255,255,.07)",
        "bg-3": "rgba(255,255,255,.12)",
        "bg-hover": "rgba(255,255,255,.2)",
        "line": "rgba(255,255,255,.12)",
        "line-strong": "rgba(255,255,255,.36)",
        "text-0": "#F5F7FB",
        "text-1": "#BCC5D6",
        "text-2": "#8E9AB0"
      },
      "accent": {
        "accent": "#C8F53C",
        "accent-hover": "#DAFF66",
        "accent-press": "#A9D925",
        "accent-ink": "#0A0D14",
        "accent-text": "#C8F53C",
        "accent-soft": "rgba(200,245,60,.16)",
        "focus": "#FFFFFF",
        "focus-gap": "#0A0D14"
      },
      "state": {
        "ok": "#35D69B",
        "warn": "#FFC933",
        "err": "#FF5A6E",
        "info": "#4DA3FF",
        "ok-soft": "rgba(53,214,155,.16)",
        "warn-soft": "rgba(255,201,51,.16)",
        "err-soft": "rgba(255,90,110,.16)",
        "info-soft": "rgba(77,163,255,.16)",
        "ahead": "#35D69B",
        "behind": "#FF5A6E"
      },
      "zone": { "z1": "#8E9AB0", "z2": "#4DA3FF", "z3": "#2DD4A7", "z4": "#FFC933", "z5": "#FF8A3D", "z6": "#FF4D6D", "z-ink": "#0A0D14" },
      "grade": { "g0": "#4CC9F0", "g1": "#3DDC97", "g2": "#FFD84D", "g3": "#FF8A3D", "g4": "#FF4D6D" },
      "hud": { "hud-plate": "rgba(10,14,22,.62)", "hud-plate-2": "rgba(12,16,26,.8)", "hud-text": "#F5F7FB", "hud-dim": "#C3CCDC", "hud-accent": "#FFFFFF" }
    },
    "light": {
      "neutral": {
        "bg-0": "#EEF2F8",
        "bg-1": "rgba(255,255,255,.66)",
        "bg-2": "rgba(15,21,34,.05)",
        "bg-3": "rgba(15,21,34,.09)",
        "bg-hover": "rgba(15,21,34,.15)",
        "line": "rgba(15,21,34,.12)",
        "line-strong": "rgba(15,21,34,.42)",
        "text-0": "#0F1522",
        "text-1": "#38425A",
        "text-2": "#566079"
      },
      "accent": {
        "accent": "#9BCC00",
        "accent-hover": "#8CBA00",
        "accent-press": "#79A300",
        "accent-ink": "#0F1522",
        "accent-text": "#566F00",
        "accent-soft": "rgba(120,160,0,.16)",
        "focus": "#0F1522",
        "focus-gap": "#EEF2F8"
      },
      "state": {
        "ok": "#0B7A57",
        "warn": "#8A5A00",
        "err": "#C2223D",
        "info": "#1561B8",
        "ok-soft": "rgba(11,122,87,.12)",
        "warn-soft": "rgba(138,90,0,.12)",
        "err-soft": "rgba(194,34,61,.1)",
        "info-soft": "rgba(21,97,184,.1)",
        "ahead": "#0B7A57",
        "behind": "#C2223D"
      },
      "zone": { "z1": "#6B7690", "z2": "#1F78E6", "z3": "#0E9E7B", "z4": "#C79500", "z5": "#D9580F", "z6": "#D12A4B", "z-ink": "#FFFFFF" },
      "grade": { "g0": "#1A8FB8", "g1": "#0E9E5B", "g2": "#B58B00", "g3": "#D9580F", "g4": "#D12A4B" },
      "note": "Le HUD de sortie reste toujours en thème sombre."
    },
    "colorblind": {
      "rg": {
        "$description": "Rouge-vert (deutéranopie / protanopie). Bleu / orange / jaune / violet, plus marques non colorées.",
        "dark": {
          "state": { "ok": "#4DA3FF", "err": "#FF9F1C", "warn": "#FFE066", "ahead": "#4DA3FF", "behind": "#FF9F1C" },
          "zone": { "z1": "#9AA6BC", "z2": "#3D8BFF", "z3": "#19C3E0", "z4": "#FFD23F", "z5": "#FF9F1C", "z6": "#C45CFF" },
          "grade": { "g0": "#3D8BFF", "g1": "#A7E3F5", "g2": "#FFE066", "g3": "#FF9F1C", "g4": "#C45CFF" }
        },
        "light": {
          "state": { "ok": "#1561B8", "err": "#C46A00", "ahead": "#1561B8", "behind": "#C46A00" },
          "zone": { "z2": "#1F6FE6", "z3": "#0B8FA8", "z4": "#B88A00", "z5": "#C46A00", "z6": "#9B2FD1" },
          "grade": { "g0": "#1F6FE6", "g1": "#5BA9C4", "g2": "#B88A00", "g3": "#C46A00", "g4": "#9B2FD1" }
        }
      },
      "by": {
        "$description": "Bleu-jaune (tritanopie). Cyan / vert / rose / rouge profond, plus marques non colorées.",
        "dark": {
          "state": { "ok": "#35D6C8", "err": "#FF4D6D", "warn": "#FF9FB1", "info": "#35D6C8", "ahead": "#35D6C8", "behind": "#FF4D6D" },
          "zone": { "z1": "#9AA6BC", "z2": "#26C9D6", "z3": "#8EE08E", "z4": "#FF9FB1", "z5": "#FF4D6D", "z6": "#B01E4A" },
          "grade": { "g0": "#26C9D6", "g1": "#8EE08E", "g2": "#F2D0D7", "g3": "#FF6E88", "g4": "#B01E4A" }
        },
        "light": {
          "state": { "ok": "#0A8F86", "err": "#C2223D", "ahead": "#0A8F86", "behind": "#C2223D" },
          "zone": { "z2": "#0E8FA0", "z3": "#4E9A4E", "z4": "#C45A73", "z5": "#C2223D", "z6": "#7E1033" },
          "grade": { "g0": "#0E8FA0", "g1": "#4E9A4E", "g2": "#B98795", "g3": "#C2223D", "g4": "#7E1033" }
        }
      }
    },
    "semantics": {
      "zoneRanges": { "z1": "< 56 % FTP (Récupération)", "z2": "56–75 % (Endurance)", "z3": "76–90 % (Tempo)", "z4": "91–105 % (Seuil)", "z5": "106–120 % (VO2max)", "z6": "> 120 % (Anaérobie)" },
      "gradeBands": {
        "g0": { "range": "< 0 % (descente)", "mark": "▼" },
        "g1": { "range": "0–3 %", "mark": "―" },
        "g2": { "range": "3–6 %", "mark": "▲" },
        "g3": { "range": "6–9 %", "mark": "▲▲" },
        "g4": { "range": "> 9 %", "mark": "▲▲▲" }
      },
      "note": "Les marques de pente s'affichent en plus dans les modes rouge-vert et bleu-jaune. Les écarts fantôme portent toujours un signe + / −."
    }
  },
  "typography": {
    "family": {
      "ui": "\"Barlow\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "num": "\"Barlow Condensed\", \"Arial Narrow\", system-ui, sans-serif",
      "source": "Google Fonts : Barlow 400/500/600/700/800 ; Barlow Condensed 500/600/700"
    },
    "numerals": "font-variant-numeric: tabular-nums ; font-feature-settings: \"tnum\" 1, \"lnum\" 1",
    "baseSizePx": 20,
    "scale": {
      "display": { "family": "num", "sizePx": 96, "lineHeight": 0.95, "weight": 700, "case": "uppercase", "letterSpacing": "0.005em" },
      "h1": { "family": "num", "sizePx": 52, "lineHeight": 1, "weight": 700, "case": "uppercase", "letterSpacing": "0.01em" },
      "h2": { "family": "num", "sizePx": 34, "lineHeight": 1.05, "weight": 700, "case": "uppercase", "letterSpacing": "0.015em" },
      "h3": { "family": "ui", "sizePx": 24, "lineHeight": 1.25, "weight": 600 },
      "body": { "family": "ui", "sizePx": 20, "lineHeight": 1.45, "weight": 400 },
      "small": { "family": "ui", "sizePx": 16, "lineHeight": 1.4, "weight": 400 },
      "hint": { "family": "ui", "sizePx": 16, "lineHeight": 1.35, "weight": 400 },
      "eyebrow": { "family": "ui", "sizePx": 15, "lineHeight": 1.2, "weight": 600, "case": "uppercase", "letterSpacing": "0.14em" },
      "numLarge": { "family": "num", "sizePx": 64, "lineHeight": 1, "weight": 700 },
      "numMedium": { "family": "num", "sizePx": 40, "lineHeight": 1, "weight": 700 },
      "statValue": { "family": "num", "sizePx": 54, "lineHeight": 1, "weight": 700 }
    },
    "hud": {
      "$description": "Tout est en em ; font-size du HUD = 16px × --hud.",
      "basePx": 16,
      "label": { "em": 0.85, "weight": 600, "letterSpacing": "0.14em", "case": "uppercase" },
      "value": { "em": 4.2, "lineHeight": 0.95 },
      "valueCompact": { "em": 3 },
      "power": { "em": 8.4, "lineHeight": 0.88 },
      "gear": { "em": 3.4 },
      "grade": { "em": 5.6 },
      "sessionTarget": { "em": 4.6 },
      "sessionTime": { "em": 3 },
      "segmentValue": { "em": 2.6 }
    }
  },
  "hudScale": {
    "s": { "factor": 0.78, "powerPx": 105 },
    "m": { "factor": 1, "powerPx": 134 },
    "l": { "factor": 1.25, "powerPx": 168 },
    "xl": { "factor": 1.5, "powerPx": 202 }
  },
  "spacing": {
    "unitPx": 4,
    "sp-1": 4, "sp-2": 8, "sp-3": 12, "sp-4": 16, "sp-5": 24, "sp-6": 32, "sp-7": 48, "sp-8": 64, "sp-9": 96
  },
  "radius": { "r-1": 8, "r-2": 16, "r-3": 26, "r-4": 36, "r-pill": 999, "hudTileEm": 1.1, "hudBannerEm": 1.2 },
  "shadow": {
    "dark": {
      "sh-1": "0 1px 2px rgba(0,0,0,.45)",
      "sh-2": "0 10px 28px rgba(0,0,0,.38)",
      "sh-3": "0 28px 72px rgba(0,0,0,.55)",
      "glass-shadow": "inset 0 1px 0 rgba(255,255,255,.3), 0 14px 36px rgba(0,0,0,.3)"
    },
    "light": {
      "sh-1": "0 1px 2px rgba(15,21,34,.12)",
      "sh-2": "0 10px 28px rgba(15,21,34,.12)",
      "sh-3": "0 28px 72px rgba(15,21,34,.2)",
      "glass-shadow": "inset 0 1px 0 #fff, 0 12px 32px rgba(31,45,80,.12)"
    },
    "focusRing": "0 0 0 3px var(--focus-gap), 0 0 0 7px var(--focus)"
  },
  "glass": {
    "blurPx": 26,
    "saturate": "180%",
    "border": { "dark": "rgba(255,255,255,.16)", "light": "rgba(255,255,255,.9)" },
    "highlight": { "dark": "rgba(255,255,255,.3)", "light": "#FFFFFF" },
    "modalBackground": { "dark": "rgba(22,28,42,.84)", "light": "rgba(255,255,255,.88)" },
    "ambient": {
      "$description": "Halos derrière le verre sur les pages hors sortie (tuilés tous les 1500 px).",
      "dark": [
        "radial-gradient(55% 38% at 6% 4%, rgba(200,245,60,.14), transparent 70%)",
        "radial-gradient(50% 40% at 94% 22%, rgba(70,150,255,.2), transparent 70%)",
        "radial-gradient(55% 35% at 28% 62%, rgba(255,110,90,.12), transparent 70%)",
        "radial-gradient(50% 35% at 88% 90%, rgba(40,220,180,.14), transparent 70%)"
      ],
      "light": [
        "radial-gradient(55% 38% at 6% 4%, rgba(190,235,60,.45), transparent 70%)",
        "radial-gradient(50% 40% at 94% 22%, rgba(120,180,255,.42), transparent 70%)",
        "radial-gradient(55% 35% at 28% 62%, rgba(255,170,140,.35), transparent 70%)",
        "radial-gradient(50% 35% at 88% 90%, rgba(120,230,200,.38), transparent 70%)"
      ]
    }
  },
  "motion": {
    "duration": { "dur-fast": "120ms", "dur-base": "200ms", "dur-slow": "360ms", "dur-scene": "600ms" },
    "easing": { "ease-out": "cubic-bezier(.2,.8,.2,1)", "ease-inout": "cubic-bezier(.65,0,.35,1)" },
    "usage": {
      "dur-fast": "survol, appui, focus",
      "dur-base": "tuiles, bascules, toasts (glissement 24 px + fondu), changement de page",
      "dur-slow": "carte de pause, fenêtres modales, dépliage de groupes",
      "dur-scene": "fondus accueil → chargement → sortie → récapitulatif"
    },
    "toast": { "enterMs": 200, "visibleMs": 3500, "visibleRecordMs": 5000, "exitMs": 200 },
    "reducedMotion": "Tous les jetons de durée passent à 0ms (attribut data-motion=\"reduced\" ou préférence système) : coupes franches, toasts immobiles, aucune animation de caméra."
  },
  "attributes": {
    "data-theme": ["dark", "light"],
    "data-cb": ["std", "rg", "by"],
    "data-hud": ["s", "m", "l", "xl"],
    "data-motion": ["reduced"]
  }
}